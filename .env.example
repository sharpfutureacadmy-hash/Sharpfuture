# SEO Configuration
# Update this with your actual domain and settings

NEXT_PUBLIC_SITE_URL=https://sharpfuture.com
NEXT_PUBLIC_SITE_NAME=Sharp Future Academy
NEXT_PUBLIC_LOCALE=en_IN

# Google Analytics (GA4)
# Get your ID from: https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console
# Get verification code from: https://search.google.com/search-console
